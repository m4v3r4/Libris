# -----------------------------------------------------------------------------
# OS / editor junk
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.tmp
*.bak
*.log
.history/

# IDE settings
.idea/
*.iml
*.ipr
*.iws
.vscode/
devtools_options.yaml

# Local environment / secrets
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pem
key.properties

# -----------------------------------------------------------------------------
# Dart / Flutter / Pub
# -----------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
/build/
coverage/

# Flutter generated build state
**/Flutter/.last_build_id
**/Flutter/ephemeral/
**/flutter/ephemeral/

# Web is intentionally unsupported in Libris v1.x
/web/

# -----------------------------------------------------------------------------
# Android
# -----------------------------------------------------------------------------
android/.gradle/
android/local.properties
android/**/.cxx/
android/app/debug/
android/app/profile/
android/app/release/

# -----------------------------------------------------------------------------
# iOS / macOS
# -----------------------------------------------------------------------------
ios/Pods/
macos/Pods/
ios/.symlinks/
macos/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
macos/Flutter/ephemeral/
DerivedData/
*.xcuserstate
xcuserdata/

# -----------------------------------------------------------------------------
# Windows / Linux generated files
# -----------------------------------------------------------------------------
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# -----------------------------------------------------------------------------
# Local database / exports / runtime data
# -----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.csv
*.xlsx
*.json.bak

# Keep application source/config JSON files tracked; only backup JSON is ignored.

# -----------------------------------------------------------------------------
# Misc build artifacts
# -----------------------------------------------------------------------------
*.class
*.pyc
*.symbols
app.*.symbols
app.*.map.json
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/
